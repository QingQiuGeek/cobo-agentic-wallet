# === CAW（Cobo Agentic Wallet）===
AGENT_WALLET_API_URL=https://agentic-wallet.cobo.com
# 以下值通过 TS SDK 在运行时获取
# AGENT_WALLET_API_KEY=  ← 通过 Pact 激活后从 pact.api_key 获取
# AGENT_ID=              ← 通过 provisionAgent() 返回
# AGENT_WALLET_WALLET_ID=  ← 通过 createWallet() 返回
# AGENT_WALLET_ADDRESS=  ← 通过 createWalletAddress() 返回

# === AI 模型（OpenAI 兼容）===
AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AI_API_KEY=
AI_MODEL_NAME=qwen3.6-27b

# === Pinata（IPFS 上传）===
PINATA_JWT=
PINATA_API_KEY=
PINATA_SECRET=

# === x402 服务端 ===
# 收款地址 = CAW 钱包地址（运行时从 CAW API 查询，无需手动填写）
# X402_PAYEE_ADDRESS=  ← 动态获取
X402_PRICE=$0.001
