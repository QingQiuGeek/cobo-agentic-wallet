# === CAW（Cobo Agentic Wallet）===
# 创建钱包流程：Provision → 获得 api_key + agent_id → Create Wallet → 获得 wallet_uuid
AGENT_WALLET_API_URL=https://api.agenticwallet.cobo.com
AGENT_WALLET_API_KEY=           # Provision 返回的 api_key
AGENT_MAIN_NODE_ID=             # 手动配置，TSS Node ID（创建 MPC 钱包需要）
AGENT_WALLET_WALLET_ID=         # createWallet() 返回
NEXT_PUBLIC_AGENT_ID=           # Provision 返回的 agent_id（前端展示用）
NEXT_PUBLIC_AGENT_WALLET_ADDRESS=  # createWalletAddress() 返回（前端+后端都可用）

# === AI 模型（OpenAI 兼容）===
AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AI_API_KEY=
AI_MODEL_NAME=qwen3.6-27b

# === Pinata（IPFS 上传）===
PINATA_JWT=
PINATA_API_KEY=
PINATA_SECRET=

# === x402 服务端 ===
X402_PRICE=$0.001

# === 链配置 ===
# 主链：ETH Sepolia（Cobo 链 ID: SETH）
# x402 facilitator: https://x402.4mica.xyz
# ERC-8004 Registry: 0x8004A818BFB912233c491871b3d84c89A494BD9e
